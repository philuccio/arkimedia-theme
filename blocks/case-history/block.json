{
    "apiVersion": 3,
    "name": "arkimedia/case-history",
    "title": "Case History",
    "description": "Contenuto libero (testo e immagini) affiancato da una colonna di immagini a proporzioni libere.",
    "category": "arkimedia",
    "icon": "excerpt-view",
    "supports": {
        "html": false,
        "align": [
            "full"
        ]
    },
    "attributes": {
        "align": {
            "type": "string",
            "default": "full"
        },
        "images": {
            "type": "array",
            "default": []
        },
        "imagesSide": {
            "type": "string",
            "default": "right"
        },
        "imagesWidth": {
            "type": "number",
            "default": 30
        },
        "columnsGap": {
            "type": "number",
            "default": 40
        },
        "imagesGap": {
            "type": "number",
            "default": 16
        },
        "imagesRadius": {
            "type": "number",
            "default": 0
        },
        "lightbox": {
            "type": "boolean",
            "default": true
        },
        "mobilePairRatio": {
            "type": "string",
            "default": "4/3"
        },
        "mobilePairGap": {
            "type": "number",
            "default": 12
        },
        "bgColor": {
            "type": "string",
            "default": ""
        },
        "textColor": {
            "type": "string",
            "default": ""
        },
        "paddingTop": {
            "type": "number",
            "default": 60
        },
        "paddingBottom": {
            "type": "number",
            "default": 60
        }
    },
    "render": "file:./render.php",
    "editorScript": "file:./build/index.js",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css"
}
